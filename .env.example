# Variables que necesita la página. Copiá este archivo como ".env" y poné los valores reales.
# El .env NO se sube a GitHub (está en .gitignore). En Render van en "Environment".

# Token de Mercado Pago (el de prueba empieza con TEST-)
MP_ACCESS_TOKEN=TEST-tu-token

# Email de la cuenta que va a ser administradora (solo en Render)
ADMIN_EMAIL=tu@mail.com

# Claves de Backblaze B2 para guardar la copia de la base con Litestream (solo en Render)
LITESTREAM_ACCESS_KEY_ID=tu-key-id
LITESTREAM_SECRET_ACCESS_KEY=tu-clave-secreta

# Mails para recuperar la contraseña (API de Brevo). Solo en Render:
# sin la clave, el link de recuperación se muestra en la terminal de php -S para probar.
# BREVO_API_KEY=xkeysib-tu-clave
# MAIL_FROM=el-mail-que-verificaste-en-brevo@gmail.com

# Dirección pública de la página. En Render ponela siempre: con ella se arman los links de los mails.
# En local no hace falta (se detecta sola).
# APP_URL=https://peritasfc.onrender.com
